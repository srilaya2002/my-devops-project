# {{ ansible_managed }}
SID_LIST_LISTENER =
  (SID_LIST =
{% if inventory_hostname == primary_host %}
    (SID_DESC =
      (GLOBAL_DBNAME = {{ primary_db_unique_name }})
      (ORACLE_HOME = {{ oracle_home }})
      (SID_NAME = {{ primary_sid }})
    )
{% else %}
    (SID_DESC =
      (GLOBAL_DBNAME = {{ standby_db_unique_name }})
      (ORACLE_HOME = {{ oracle_home }})
      (SID_NAME = {{ standby_sid }})
    )
{% endif %}
  )

LISTENER =
  (DESCRIPTION_LIST =
    (DESCRIPTION =
      (ADDRESS = (PROTOCOL = TCP)(HOST = 0.0.0.0)(PORT = 1521))
    )
  )
