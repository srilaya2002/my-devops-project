# {{ ansible_managed }}
# Rebuild target's init parameters -- mirrors init_standby.ora.j2 with
# primary/standby reversed, since primary_host is the one being rebuilt as
# a standby of standby_db_unique_name after a real failover.
db_name={{ primary_sid }}
db_unique_name={{ primary_db_unique_name }}
instance_name={{ primary_sid }}
compatible=19.0.0
enable_pluggable_database=true

control_files='{{ primary_datafile_dir }}/control01.ctl'
db_create_file_dest='{{ primary_datafile_dir }}'

db_file_name_convert='{{ standby_datafile_dir }}','{{ primary_datafile_dir }}'
log_file_name_convert='{{ standby_datafile_dir }}','{{ primary_datafile_dir }}'

db_recovery_file_dest='{{ primary_datafile_dir }}/fast_recovery_area'
db_recovery_file_dest_size={{ primary_recovery_area_size }}

log_archive_config='dg_config=({{ primary_db_unique_name }},{{ standby_db_unique_name }})'
log_archive_dest_1='location=USE_DB_RECOVERY_FILE_DEST valid_for=(ALL_LOGFILES,ALL_ROLES) db_unique_name={{ primary_db_unique_name }}'
log_archive_dest_state_1=enable

fal_server={{ standby_db_unique_name }}
fal_client={{ primary_db_unique_name }}
standby_file_management=AUTO
remote_login_passwordfile=EXCLUSIVE

audit_file_dest='{{ oracle_base }}/admin/{{ primary_sid }}/adump'
diagnostic_dest='{{ oracle_base }}'
undo_tablespace=UNDOTBS1
sga_target=1600M
pga_aggregate_target=512M
processes=300
open_cursors=300
