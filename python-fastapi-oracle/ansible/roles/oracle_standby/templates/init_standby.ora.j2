# {{ ansible_managed }}
# Standby init parameters. First deployed from a best-effort reconstruction
# of the manually-built pfile; missing db_recovery_file_dest/_size (needed
# because log_archive_dest_1 below uses USE_DB_RECOVERY_FILE_DEST) caused a
# real failure later when converting the standby to an spfile -- ORA-16032 /
# ORA-19801 at STARTUP MOUNT, fixed live and folded back in here so a fresh
# build doesn't repeat it.
db_name={{ primary_sid }}
db_unique_name={{ standby_db_unique_name }}
instance_name={{ standby_sid }}
compatible=19.0.0
enable_pluggable_database=true

control_files='{{ standby_datafile_dir }}/control01.ctl'
db_create_file_dest='{{ standby_datafile_dir }}'

# Must map to a genuinely different path than the primary's -- an identity
# mapping (same path on both sides) still trips RMAN-05001 during duplicate.
db_file_name_convert='{{ primary_datafile_dir }}','{{ standby_datafile_dir }}'
log_file_name_convert='{{ primary_datafile_dir }}','{{ standby_datafile_dir }}'

db_recovery_file_dest='{{ standby_datafile_dir }}/fast_recovery_area'
db_recovery_file_dest_size={{ standby_recovery_area_size }}

log_archive_config='dg_config=({{ primary_db_unique_name }},{{ standby_db_unique_name }})'
log_archive_dest_1='location=USE_DB_RECOVERY_FILE_DEST valid_for=(ALL_LOGFILES,ALL_ROLES) db_unique_name={{ standby_db_unique_name }}'
log_archive_dest_2='service={{ primary_db_unique_name }} valid_for=(ONLINE_LOGFILES,PRIMARY_ROLE) db_unique_name={{ primary_db_unique_name }}'
log_archive_dest_state_1=enable
log_archive_dest_state_2=enable

fal_server={{ primary_db_unique_name }}
fal_client={{ standby_db_unique_name }}
standby_file_management=AUTO
remote_login_passwordfile=EXCLUSIVE

audit_file_dest='{{ oracle_base }}/admin/{{ standby_sid }}/adump'
diagnostic_dest='{{ oracle_base }}'
undo_tablespace=UNDOTBS1
sga_target=1600M
pga_aggregate_target=512M
processes=300
open_cursors=300
